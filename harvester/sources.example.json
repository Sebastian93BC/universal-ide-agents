{
  "schemaVersion": "1.0.0",
  "description": "Configuración de ejemplo para el motor periódico Knowledge & Skill Harvester. Copia este archivo a harvester/sources.local.json (ignorado por Git) y ajusta tus rutas locales.",
  "watchRoots": [
    {
      "id": "client-projects",
      "path": "~/Desktop/clientes/proyectos",
      "category": "projects",
      "maxDepth": 5
    },
    {
      "id": "dagster-medallion-projects",
      "path": "~/Desktop/clientes/proyectos_dagster",
      "category": "projects",
      "maxDepth": 5
    },
    {
      "id": "duckdb-dagster-course-project",
      "path": "~/Desktop/cursos/docker_duckdb",
      "category": "projects",
      "maxDepth": 4
    },
    {
      "id": "personal-projects",
      "path": "~/Desktop/Proyectos",
      "category": "projects",
      "maxDepth": 4,
      "excludeDirs": [
        "universal-ide-agents"
      ]
    },
    {
      "id": "ide-selection-benchmarks",
      "path": "~/Desktop/investigacion/seleccion-ide",
      "category": "research",
      "maxDepth": 3
    },
    {
      "id": "study-programs-courses",
      "path": "~/Desktop/cursos/programas",
      "category": "courses",
      "maxDepth": 5
    },
    {
      "id": "internal-courses",
      "path": "~/Desktop/cursos/internos",
      "category": "courses",
      "maxDepth": 4
    },
    {
      "id": "claude-project-memories",
      "path": "~/.claude/projects",
      "category": "agent-memory",
      "maxDepth": 4
    },
    {
      "id": "antigravity-ide-knowledge",
      "path": "~/.gemini/antigravity-ide/knowledge",
      "category": "agent-memory",
      "maxDepth": 4
    }
  ],
  "targetPatterns": [
    ".agents/**/*.md",
    ".agents/**/*.py",
    ".claude/**/*.md",
    ".claude/**/*.json",
    ".github/agents/**/*.md",
    ".github/skills/**/*.md",
    ".github/instructions/**/*.md",
    ".github/prompts/**/*.md",
    "AGENTS.md",
    "CLAUDE.md",
    "GEMINI.md",
    "**/memory/*.md",
    "**/fallos/*.md",
    "**/ARQUITECTURA*.md",
    "**/docs/standards/*.md"
  ]
}
