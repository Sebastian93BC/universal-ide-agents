{
  "schemaVersion": "2.0.0",
  "description": "Qué carpetas recorre el Knowledge Harvester y qué archivos lee en ellas. Los patrones valen a cualquier profundidad dentro de cada carpeta (una carpeta puede contener muchos proyectos). Cópialo con 'python3 scripts/harvest.py --init' (crea harvester/sources.local.json, ignorado por git), cambia las rutas por las tuyas y comprueba con '--check-config'. Las rutas admiten '~'. El propio universal-ide-agents nunca se recorre.",
  "includePatterns": [
    "AGENTS.md",
    "CLAUDE.md",
    "GEMINI.md",
    ".agents/**/*.md",
    ".claude/**/*.md",
    ".claude/**/*.json",
    ".github/agents/**/*.md",
    ".github/skills/**/*.md",
    ".github/instructions/**/*.md",
    ".github/prompts/**/*.md",
    "**/memory/*.md",
    "**/docs/**/*.md"
  ],
  "fileExtensions": [".md", ".py", ".json", ".txt"],
  "excludeDirs": ["node_modules", ".git", ".venv", "venv", "__pycache__", "dist", "build"],
  "watchRoots": [
    {
      "id": "mis-proyectos",
      "path": "~/Proyectos",
      "category": "projects",
      "maxDepth": 4
    },
    {
      "id": "mis-cursos",
      "path": "~/Cursos",
      "category": "courses",
      "maxDepth": 4,
      "includePatterns": ["**/*.md"]
    },
    {
      "id": "memorias-claude-code",
      "path": "~/.claude/projects",
      "category": "agent-memory",
      "maxDepth": 4,
      "includePatterns": ["**/memory/*.md"]
    },
    {
      "id": "conocimiento-antigravity",
      "path": "~/.gemini/antigravity/knowledge",
      "category": "agent-memory",
      "maxDepth": 4,
      "includePatterns": ["**/*.md"]
    }
  ]
}
